{
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "Elevating.Api",
    "Audience": "Elevating.Web",
    "AccessTokenMinutes": 15
  },
  "RefreshToken": {
    "LifetimeDays": 7
  },
  "RefreshCookie": {
    "Name": "__Secure-Elevating.RefreshToken",
    "SameSite": "None",
    "Path": "/api/auth"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}